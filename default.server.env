# Server base URL
PUBLIC_URL=

# Max size for returned manifest files
#EMBEDDED_LENGTH_MAX=

# Max size for uploaded files
#FILE_SIZE_MAX=

# VCS version string if not using CI image
#APP_VERSION_STRING=

# local deploy server port
#PORT=

# test server port; use if conflict with default
#TEST_PORT=

# IDP jwks url for jwt auth
#JWKS_URL=

# Turn off auth token requirement
#DEV=1

# Rate limiting window (ms) and max POST requests per client IP within that window.
# Applies to all POST endpoints, including /authcheck.
#RATE_LIMIT_WINDOW_MS=60000
#RATE_LIMIT_MAX_REQUESTS=30

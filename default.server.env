# Server base URL
PUBLIC_URL=

# Max size for returned manifest files
#EMBEDDED_LENGTH_MAX=

# Max size for uploaded files
#FILE_SIZE_MAX=

# VCS version string if not using CI image
#APP_VERSION_STRING=

# local deploy server port
#PORT=

# test server port; use if conflict with default
#TEST_PORT=

# IDP jwks url for jwt auth
#JWKS_URL=

# Turn off auth token requirement
#DEV=1

# base64url-encoded 32-byte AES-256 key used to encrypt passcodes at rest.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# or: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#PASSCODE_ENCRYPTION_KEY=

# Expected `iss` claim on JWTs, for defense-in-depth beyond JWKS-based signature checks
#JWT_ISSUER=

# Comma-separated list of allowed origins for CORS.
# Leave unset to reflect any origin (default, suitable for local development).
# eg: CORS_ALLOWED_ORIGINS=https://app.example.org,https://admin.example.org
#CORS_ALLOWED_ORIGINS=

# Override rate limiting window (ms) and max POST requests per client IP within that window.
# Applies to all POST endpoints, including /authcheck.
#RATE_LIMIT_WINDOW_MS=60000
#RATE_LIMIT_MAX_REQUESTS=30
